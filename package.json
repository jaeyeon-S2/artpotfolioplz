{
  "name": "fullstack-app",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install --workspaces --include-workspace-root",
    "build:frontend": "npm --prefix frontend run build",
    "mirror:frontend-dist": "node frontend/scripts/copy-dist.mjs",
    "build": "npm run build:frontend && npm run mirror:frontend-dist",
    "postinstall": "npm run build",
    "start": "node backend/server.js",
    "dev:backend": "node backend/server.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "npm run dev:backend & npm run dev:frontend"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "tsx": "^4.20.6"
  }
}